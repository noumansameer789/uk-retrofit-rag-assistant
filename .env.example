# Manual local Ollama defaults. Docker Compose supplies these automatically.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible alternative. Never commit a populated secret.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: point the API at a reviewed generated catalogue.
GUIDANCE_CATALOGUE=
